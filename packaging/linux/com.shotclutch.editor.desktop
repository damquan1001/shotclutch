[Desktop Entry]
Type=Application
Name=ShotClutch
GenericName=Video Editor
Comment=Edit video, color and sound
Exec=shotclutch %F
TryExec=shotclutch
Icon=com.shotclutch.editor
Terminal=false
StartupNotify=true
StartupWMClass=com.shotclutch.editor
Categories=AudioVideo;Video;AudioVideoEditing;
MimeType=application/x-filmcraft;video/mp4;video/x-m4v;video/quicktime;video/x-matroska;video/webm;video/vnd.avi;video/x-msvideo;application/mxf;video/mp2t;video/mpeg;video/3gpp;
Keywords=video;editor;film;timeline;color;grading;nle;
