<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>com.shotclutch.editor</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>ShotClutch</name>
  <summary>Edit video, color and sound</summary>
  <developer id="com.shotclutch">
    <name>ShotClutch contributors</name>
  </developer>
  <description>
    <p>
      ShotClutch is a video editor. Edit video, color and sound
    </p>
  </description>
  <launchable type="desktop-id">com.shotclutch.editor.desktop</launchable>
  <icon type="stock">com.shotclutch.editor</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://github.com/damquan1001/shotclutch</url>
  <url type="bugtracker">https://github.com/damquan1001/shotclutch/issues</url>
  <url type="help">https://github.com/damquan1001/shotclutch</url>
  <url type="contact">https://github.com/damquan1001/shotclutch/discussions</url>
  <categories>
    <category>AudioVideo</category>
    <category>Video</category>
    <category>AudioVideoEditing</category>
  </categories>
  <keywords>
    <keyword>video</keyword>
    <keyword>video editor</keyword>
    <keyword>timeline</keyword>
    <keyword>color grading</keyword>
    <keyword>nle</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#9fd0ff</color>
    <color type="primary" scheme_preference="dark">#1f64ba</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <provides>
    <binary>shotclutch</binary>
    <mediatype>application/x-shotclutch</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
